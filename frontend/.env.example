# Stream API Key
VITE_STREAM_API_KEY=your_stream_api_key

# Backend API URL (e.g., https://your-backend.vercel.app/api or Railway/Render API URL)
VITE_API_URL=https://your-backend.vercel.app/api

# Backend Socket URL (if hosted on Railway/Render for WebSocket support)
VITE_SOCKET_URL=https://your-backend.vercel.app
