# Stream public API key (not the Stream API secret)
VITE_STREAM_API_KEY=your_stream_api_key

# Vercel backend project URL
VITE_API_URL=https://your-backend.vercel.app/api

# Optional persistent Socket.IO server URL. Vercel serverless functions do not
# support Socket.IO connections; use a persistent Node.js host for this service.
VITE_SOCKET_URL=https://your-socket-server.example.com
