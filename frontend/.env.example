# Stream public API key (not the Stream API secret)
VITE_STREAM_API_KEY=your_stream_api_key

# Backend URL ending in /api (for example, https://your-service.onrender.com/api)
VITE_API_URL=https://your-service.onrender.com/api

# Persistent backend URL used for Socket.IO connections.
VITE_SOCKET_URL=https://your-service.onrender.com
