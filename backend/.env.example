# Server Configuration
PORT=5001
NODE_ENV=production

# Frontend origin, used for CORS and cross-site cookies.
# Required in production - without it only localhost and *.vercel.app are allowed.
CLIENT_URL=https://your-frontend-domain.vercel.app

# Optional: extra CORS origins, comma separated
# EXTRA_ALLOWED_ORIGINS=https://staging.example.com,https://admin.example.com

# MongoDB Database
# Include the database name in the path, otherwise Mongo defaults to "test":
#   mongodb+srv://user:pass@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# Stream Chat & Video API
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# JWT Secret
JWT_SECRET_KEY=your_jwt_secret_key

# AI Integration
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Optional model overrides (defaults shown).
# gemini-1.5-flash was retired - use a current model or the rolling alias.
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
